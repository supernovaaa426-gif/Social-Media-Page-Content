          ]
        },
        "options": {}
      },
      "id": "filter-approved",
      "name": "Only Approved",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [680, 340]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
